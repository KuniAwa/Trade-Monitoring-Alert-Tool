DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

OPENAI_API_KEY=
# 対話（追加質問）用。未設定時は gpt-5.6-luna
# OPENAI_MODEL_CONVERSATION=gpt-5.6-luna
# 回答案生成・フィードバック再生成用。未設定時は gpt-5.6-luna
# OPENAI_MODEL_DRAFT_ANSWER=gpt-5.6-luna

PERPLEXITY_API_KEY=
# Agent API preset（Sonar 相当: fast）。low / medium / high で深い調査に変更可
# PERPLEXITY_AGENT_PRESET=fast

# 未設定なら認証なし（ローカル用）。Vercel では必ず設定する。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
